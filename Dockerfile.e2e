FROM node:20-bookworm

WORKDIR /app

# Install dependencies (cached layer)
COPY package.json yarn.lock ./
RUN HUSKY=0 yarn --frozen-lockfile

# Install Playwright Chromium + system deps (matches installed @playwright/test version)
RUN npx playwright install --with-deps chromium

# Copy source
COPY . .

ENV CI=true

# Playwright webServer handles build + start internally
CMD ["yarn", "e2e"]
